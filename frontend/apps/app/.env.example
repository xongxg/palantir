# Copy this file to .env.local for local development overrides.
# .env.local is git-ignored.

# 前端 dev server 端口（默认 3000）
VITE_PORT=3000

# Vite proxy 的后端目标地址（服务器内部地址，浏览器不可见）
# 改这个来指向后端端口
VITE_BACKEND=http://localhost:8080

# 浏览器直连后端时才设置（跨域部署场景，通常留空走 proxy）
# VITE_API_BASE=http://your-server-ip:9090
